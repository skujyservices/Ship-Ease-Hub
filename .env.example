# Copy to .env.local and fill in. Never commit real keys.

# App
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Protects the daily storage job (/api/cron/storage); any long random string
CRON_SECRET=
# The account that signs up with this email becomes the admin
ADMIN_EMAIL=

# Database: Supabase → Connect → ORMs → Prisma
# Pooled connection for the app:
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for creating/updating tables:
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Supabase project (for file storage later); the publishable key is safe to expose
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Supabase → Project Settings → API Keys → Secret keys) for package photo uploads
SUPABASE_SECRET_KEY=

# Terminal Africa (https://docs.terminal.africa/tship)
# "sandbox" uses https://sandbox.terminal.africa/v1, "live" uses https://api.terminal.africa/v1
TERMINAL_ENV=sandbox
TERMINAL_SECRET_KEY=

# Paystack (NGN)
PAYSTACK_SECRET_KEY=

# Stripe (GBP / USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Ship Ease Hub <noreply@example.com>"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of the approved template (see README → WhatsApp template) and its language code
WHATSAPP_TEMPLATE=shipment_update
WHATSAPP_TEMPLATE_LANG=en

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
