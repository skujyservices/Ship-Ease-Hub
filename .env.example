# Copy to .env.local and fill in. Never commit real keys.

# App
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# The account that signs up with this email becomes the admin
ADMIN_EMAIL=

# Database (PostgreSQL, e.g. Neon or Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/shipeasehub

# Terminal Africa (https://docs.terminal.africa/tship)
# "sandbox" uses https://sandbox.terminal.africa/v1, "live" uses https://api.terminal.africa/v1
TERMINAL_ENV=sandbox
TERMINAL_SECRET_KEY=

# Paystack (NGN)
PAYSTACK_SECRET_KEY=

# Stripe (GBP / USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Ship Ease Hub <noreply@example.com>"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
